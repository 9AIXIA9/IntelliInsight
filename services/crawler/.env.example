# 服务器配置
SERVER_LISTEN_ON=0.0.0.0:8999
APP_MODE=dev

# 日志配置
LOG_LEVEL=debug
LOG_MODE=console

# Consul配置
CONSUL_HOST=127.0.0.1:8500
CONSUL_SERVICE_KEY=consul-crawler.rpc

# Redis配置
REDIS_HOST=127.0.0.1:6379
REDIS_TYPE=node
REDIS_PASS=your_redis_password
REDIS_DB=0

# MongoDB配置
MONGODB_URI=mongodb://username:password@localhost:27017/
MONGODB_DATABASE=crawler_db
MONGODB_POST_COLLECTION=crawler_posts
MONGODB_COMMENT_COLLECTION=crawler_comments
MONGODB_TASK_COLLECTION=crawler_tasks

# 任务队列配置
TASK_QUEUE_WORK_QUEUE_SIZE=100
TASK_QUEUE_MAX_WORKERS=5
TASK_QUEUE_MAX_CACHE=100
TASK_DIVIDE_THRESHOLD=2

# 资源配置
RESOURCE_DATA_BASE_PATH=/path/to/browser/data
RESOURCE_BROWSER_PATH=/path/to/browser/executable
RESOURCE_HEADLESS=false
RESOURCE_MAX_SIZE=5
RESOURCE_INITIAL_SIZE=1
RESOURCE_HEALTH_CHECK_INTERVAL=60s
RESOURCE_LOAD_BALANCING_STRATEGY=0

# BloomFilter配置
BLOOM_FILTER_BITS=10000000
BLOOM_FILTER_KEY=crawler:bloom

# SnowflakeID配置
SNOWFLAKE_START_TIME=2025-05-10T00:00:00Z
SNOWFLAKE_MACHINE_NODE=1